modules = ["web", "python-base-3.13", "nodejs-22", "postgresql-16"]

[nix]
channel = "stable-25_05"
packages = ["glib", "gtk3", "nss", "nspr", "atk", "cups", "dbus", "expat", "libdrm", "mesa", "pango", "cairo", "xorg.libX11", "xorg.libXcomposite", "xorg.libXdamage", "xorg.libXext", "xorg.libXfixes", "xorg.libXrandr", "xorg.libxcb", "libgbm", "libglvnd", "libxkbcommon", "alsa-lib"]

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd dailybars && DAILYBARS_ENVIRONMENT=development npm run db:setup && DAILYBARS_ENVIRONMENT=development npm run build && DAILYBARS_ENVIRONMENT=development node server/server.mjs"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[[ports]]
localPort = 5071
externalPort = 3001

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[deployment]
deploymentTarget = "autoscale"
run = ["bash", "-c", "cd dailybars && DAILYBARS_ENVIRONMENT=production node server/server.mjs"]
build = ["bash", "-c", "cd dailybars && DAILYBARS_ENVIRONMENT=production npm run build"]

[userenv]

[userenv.production]
DAILYBARS_RELEASE_ENABLED = "false"
