{
  "name": "daily-raps",
  "version": "3.0.0",
  "description": "Write bars daily. Stay creative. Oakland energy meets brutalist design. GUAPDAD 4000 Edition.",
  "author": "GUAPDAD 4000",
  "license": "UNLICENSED",
  "private": true,
  "homepage": "https://dailyraps.app",
  "repository": {
    "type": "git",
    "url": "https://github.com/guapdad4000/dailybars.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "dev": "npx serve .",
    "serve": "npx serve .",
    "preview": "npm run build && npx serve dist",
    "smoke": "npm run build && node tests/smoke.mjs",
    "screenshots": "npm run build && node scripts/capture-screenshots.mjs",
    "check": "npm run build && node tests/smoke.mjs && npm audit --omit=dev",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "cap:init": "npx cap init 'Daily Raps' com.guapdad4000.dailyraps --web-dir dist",
    "cap:add:ios": "npx cap add ios",
    "cap:add:android": "npx cap add android",
    "cap:sync": "npx cap sync",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "ios:build": "npm run build && npm run cap:sync && npx cap open ios",
    "android:build": "npm run build && npm run cap:sync && npx cap open android",
    "db:setup": "node server/setup-db.mjs",
    "test:migration": "npm run db:setup && node server/migrate-supabase.mjs import tests/fixtures/legacy-migration.json && node server/migrate-supabase.mjs verify tests/fixtures/legacy-migration.json",
    "stripe:seed": "node server/seed-stripe-products.mjs"
  },
  "dependencies": {
    "@capacitor/core": "^8.5.0",
    "@capacitor/keyboard": "^8.0.5",
    "@capacitor/splash-screen": "^8.0.2",
    "@capacitor/status-bar": "^8.0.3",
    "@revenuecat/purchases-capacitor": "^13.4.1",
    "@revenuecat/purchases-js": "^1.53.1",
    "@supabase/supabase-js": "^2.56.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "lucide": "^0.468.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "pg": "^8.16.3",
    "stripe": "^22.5.0",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/cli": "^8.5.0",
    "@capacitor/ios": "^8.5.0",
    "esbuild": "^0.25.12",
    "playwright": "^1.62.1",
    "serve": "^14.2.4"
  },
  "overrides": {
    "xcode": {
      "uuid": "^11.1.1"
  }
  },
  "capacitor": {
    "appId": "com.guapdad4000.dailyraps",
    "appName": "Daily Raps",
    "webDir": "dist"
  },
  "keywords": [
    "music",
    "lyrics",
    "songwriting",
    "rap",
    "hip-hop",
    "creative",
    "oakland",
    "bay-area",
    "guapdad4000",
    "pwa",
    "mobile-app"
  ]
}
