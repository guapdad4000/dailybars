DAILYBARS_ENVIRONMENT=production
# Required for a customer release. Builds stay fail-closed until this is true.
DAILYBARS_RELEASE_ENABLED=false
DAILYBARS_SUPABASE_URL=https://your-project.supabase.co
DAILYBARS_SUPABASE_ANON_KEY=your-public-anon-key
DAILYBARS_AI_FUNCTION=dailybars-ai
DAILYBARS_DELETE_ACCOUNT_FUNCTION=delete-account
# An HTTPS URL allowed in Supabase Auth > URL Configuration > Redirect URLs.
DAILYBARS_AUTH_REDIRECT_URL=https://dailyraps.app

# Server-only native data API configuration. DATABASE_URL is injected by Replit.
DATABASE_URL=
# Reused only to validate Supabase Auth access tokens at the API boundary.
# The anon key is safe for the browser; do not expose a service-role key.
DAILYBARS_SUPABASE_URL=https://your-project.supabase.co
DAILYBARS_SUPABASE_ANON_KEY=

DAILYBARS_REVENUECAT_WEB_KEY=
DAILYBARS_REVENUECAT_IOS_KEY=
DAILYBARS_REVENUECAT_ANDROID_KEY=
DAILYBARS_REVENUECAT_OFFERING=dailybars_pro
DAILYBARS_REVENUECAT_ENTITLEMENT=daily raps Pro

# Supabase Edge Function secrets
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUPABASE_SERVICE_ROLE_KEY=
